{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["bun"]
  },
  "include": [
    "*.ts",
    "gemini/**/*.ts",
    "memory/**/*.ts",
    "pipeline/**/*.ts",
    "sql/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
