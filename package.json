{
  "name": "aira",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:cli": "bun run scripts/aira-cli.test.ts && bun run scripts/install-cli.test.ts && bun run scripts/install-cli-path.test.ts && bun run scripts/install-installer.test.ts && bun run scripts/aira-setup.test.ts",
    "test:chroma": "bun run scripts/chroma-setup.test.ts",
    "test:memory-integrity": "bun run scripts/test-memory-integrity.ts",
    "test:characters": "bun run scripts/test-character-registry.ts",
    "test:rps": "bun run scripts/test-rps.ts",
    "start": "bun run scripts/supervisor.ts start",
    "stop": "bun run scripts/supervisor.ts stop",
    "logs": "bun run scripts/supervisor.ts logs",
    "install-cli": "bun run scripts/install-cli.ts",
    "forget": "bun run scripts/forget.ts",
    "prepublishOnly": "bun run typecheck && bun run test:characters && bun run test:cli"
  },
  "dependencies": {
    "@chroma-core/default-embed": "^0.1.9",
    "@google/genai": "latest",
    "chromadb": "latest",
    "discord.js": "latest",
    "dotenv": "latest",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "sharp": "^0.35.5"
  },
  "version": "0.1.0",
  "description": "Aira Discord AI bot — one-command runtime",
  "bin": {
    "aira": "bin/aira.cjs"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "characters/",
    "images/",
    "docs/",
    "install.sh",
    "bun.lock",
    "tsconfig.json",
    ".env.example",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Tulipskun/aira.git"
  }
}
