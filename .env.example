# Discord
DISCORD_TOKEN=
# Owner-only commands: !islacomehere and !unset
DISCORD_OWNER_ID=
# Optional override; default is ./.aira/discord-config.json
DISCORD_CONFIG_PATH=./.aira/discord-config.json

# AI responses are accepted only from this channel. Set via !islacomehere.
# DISCORD_RESPONSE_CHANNEL_ID is legacy/optional; persistent lock is stored in .aira.
DISCORD_RESPONSE_CHANNEL_ID=

# Gemini models
GEMINI1_MODEL=
gemini1_API_KEYS=
GEMINI2_MODEL=
GEMINI2_API_KEYS=
# Path to Gemini 1 character/system prompt. Default: ./prompts/isla.md
GEMINI1_SYSTEM_PROMPT_FILE=./prompts/isla.md

# Gemini Embedding 2
GEMINI_EMBEDDING2_MODEL=gemini-embedding-2
GEMINI_EMBEDDING2_DIMENSION=768
GEMINI_EMBEDDING2_API_KEYS=
# Optional override; default is ./.aira/gemini-key-state.json
GEMINI_KEY_STATE_FILE=./.aira/gemini-key-state.json

# Chroma vector database
# Chroma runs as a local Chroma server; this Node app connects to it.
# Vectors sent to Chroma are generated by Gemini Embedding 2.
CHROMA_URL=http://127.0.0.1:8000
CHROMA_COLLECTION=aira_memories

# SQLite
# Conversation history, relationship and profile data are stored here.
SQLITE_PATH=./.aira/aira.db
