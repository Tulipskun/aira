# Discord
ISLA_TOKEN=
DISCORD_OWNER_ID=
DISCORD_CONFIG_PATH=./.aira/discord-config.json
DISCORD_RESPONSE_CHANNEL_ID=

# Gemini API
# One comma-separated pool is shared by Gemini 1, Gemini 2 and Gemini Embedding 2.
# Example: GEMINI_API_KEY=key1,key2
GEMINI_API_KEY=
# Defaults: Gemini 1 = gemini-3.1-flash-lite, Gemini 2 = gemini-3.5-flash-lite.
GEMINI1_MODEL=gemini-3.1-flash-lite
GEMINI1_SYSTEM_PROMPT_FILE=./src/gemini/prompts/isla.md
GEMINI2_MODEL=gemini-3.5-flash-lite
# Gemini 2's instruction as a template. The {{placeholders}} in it are filled from the code that owns
# each number (affinity floor/range, the bond ladder and its xp gates, the images/ catalog), so this
# file is wording only. Unlike Gemini 1's prompt it is re-read per request and cached by mtime:
# editing it takes effect on the next message, no restart.
# GEMINI2_SYSTEM_PROMPT_FILE=./src/gemini/prompts/isla-state.md
GEMINI_EMBEDDING2_MODEL=gemini-embedding-2
GEMINI_EMBEDDING2_DIMENSION=768
GEMINI_KEY_STATE_FILE=./.aira/gemini-key-state.json
# Thought signatures for Gemini 1's synthetic search_memory context are harvested at runtime and
# kept in an in-memory pool of at most 5 real signatures. Persistence is deferred until idle or shutdown.
GEMINI_THOUGHT_SIGNATURE_FILE=./.aira/gemini-thought-signatures.json
# Optional extra seed signature(s), comma-separated:
# GEMINI1_THOUGHT_SIGNATURE=
# Idle persistence delay; default is 10 minutes.
# GEMINI_SIGNATURE_FLUSH_MINUTES=10

# Debug: dump the exact Gemini 1 + Gemini 2 request payloads and responses. ENABLED BY DEFAULT.
# The dumper keeps only the latest 3 Gemini turns (up to 6 request/response/error records).
# Set GEMINI_DEBUG_PAYLOAD=0/false/no/off to disable it. The setting is read on every call.
GEMINI_DEBUG_PAYLOAD=1
# Dumps contain conversation history (PII) -- keep the file inside gitignored .aira/:
# GEMINI_DEBUG_PAYLOAD_FILE=./.aira/logs/gemini-payload.jsonl

# Chroma
CHROMA_URL=http://127.0.0.1:8000
CHROMA_COLLECTION=aira_memories

# SQLite
SQLITE_PATH=./.aira/aira.db

# Zone used to render timestamps *inside prompts* (history, current message, memories).
# Storage stays UTC; only what the model sees is converted, e.g.
#   2026-08-30T20:01:47Z -> 2026-08-31T03:01:47+07:00
# Leave unset for Thailand. Needs a restart (read at module load).
# ISLA_TIMEZONE=Asia/Bangkok

# Folder holding Isla's expression images. The directory listing IS the `select_image` enum offered
# to Gemini 2 (descriptions come from manifest.json inside it), so adding a picture needs no code
# change. Relative paths resolve from the project root.
# ISLA_IMAGES_DIR=./images

# Loopback port for the bot's own /health endpoint (src/bot/health.ts). scripts/daemon.ts polls it
# every 20s and restarts the bot when the Discord gateway stops delivering events while the process
# is still alive — the failure that previously needed a human to notice. Both the bot and the
# watchdog read this one value, so changing it here moves both; leaving it unset uses 8091.
# Keep it on 127.0.0.1: it exposes counters and the response channel id, and it is what lets a
# watchdog kill a healthy-looking process. Needs a restart.
# ISLA_HEALTH_PORT=8091
