# Required Discord bot token
DISCORD=

# Recommended: owner Discord user ID (application ownership is also checked at runtime)
DISCORD_OWNER_ID=

# Optional. Comma-separated Gemini API keys; may instead be configured through the Discord Control Panel.
GEMINI_API_KEY=
# Optional stage-specific pools. They fall back to GEMINI_API_KEY.
GEMINI1_API_KEYS=
GEMINI2_API_KEYS=
GEMINI_EMBEDDING2_API_KEYS=

# Optional initial response channel (can be selected from the owner-only Control Panel)
DISCORD_RESPONSE_CHANNEL_ID=

# Gemini models
GEMINI1_MODEL=gemini-3.1-flash-lite
GEMINI2_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING2_MODEL=gemini-embedding-2
GEMINI_EMBEDDING2_DIMENSION=768

# Persistent storage paths (keep .aira on persistent server storage)
SQLITE_PATH=./.aira/aira.db
CHROMA_PATH=./.aira/chroma
# Leave empty for embedded local Chroma. Set a URL only when using an external Chroma server.
CHROMA_URL=
CHROMA_COLLECTION=aira_memories
ISLA_EPISODE_COLLECTION=aira_episodes

# Prompt and image assets
GEMINI1_SYSTEM_PROMPT_FILE=./prompts/isla.md
GEMINI2_SYSTEM_PROMPT_FILE=./prompts/isla-state.md
ISLA_IMAGES_DIR=./images

# Locale and health endpoint
ISLA_TIMEZONE=Asia/Bangkok
ISLA_HEALTH_PORT=8091
LOG_LEVEL=INFO

# Memory retrieval tuning
ISLA_MEMORY_MAX_RESULTS=8
ISLA_MEMORY_MIN_SIMILARITY=0.6
ISLA_MEMORY_DEDUPE_SIMILARITY=0.92
ISLA_EPISODE_MAX_RESULTS=5
ISLA_EPISODE_MIN_SIMILARITY=0.55
ISLA_EPISODE_GAP_MINUTES=30

# Debug payload dumps can contain conversation history and personal information. Leave disabled.
GEMINI_DEBUG_PAYLOAD=0
GEMINI_DEBUG_PAYLOAD_FILE=./.aira/logs/gemini-payload.json
